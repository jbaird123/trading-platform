{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/rmm.schema.json",
  "title": "Regime Market Manager Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-friendly name for this RMM configuration."
    },
    "version": {
      "type": "string",
      "description": "Optional version tag for this RMM config."
    },
    "timeframe": {
      "type": "string",
      "description": "Timeframe for regime classification (e.g., '1D', '4H', '1H', '15M'). Must be a valid pandas resample frequency.",
      "pattern": "^\\d*[DHMS]$"
    },
    "features": {
      "type": "array",
      "description": "Indicators/features used to classify regimes.",
      "items": { "$ref": "#/$defs/feature" }
    },
    "hysteresis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_bars": {
          "type": "integer",
          "minimum": 0,
          "description": "Bars a label must persist before switching."
        },
        "cooldown_bars": {
          "type": "integer",
          "minimum": 0,
          "description": "Bars to wait after a switch before switching again."
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Lowest confidence required to accept a regime."
        },
        "allow_labels": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Whitelist of labels permitted for trading."
        },
        "block_labels": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Blacklist of labels to block from trading."
        }
      }
    },
    "regimes": {
      "type": "array",
      "description": "List of regime definitions and their conditions.",
      "items": { "$ref": "#/$defs/regime" },
      "minItems": 1
    }
  },
  "required": ["regimes"],
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Local identifier used by conditions (e.g., ema_slope)."
        },
        "type": {
          "type": "string",
          "enum": [
            "SMA",
            "EMA",
            "WMA",
            "MACD",
            "PSAR",
            "ADX",
            "RSI",
            "STOCH",
            "CCI",
            "ROC",
            "BB",
            "BBWidth",
            "ATR",
            "HHV",
            "CHOP",
            "ICHIMOKU",
            "SUPERTREND",
            "LLV",
            "DC",
            "KC",
            "OBV",
            "CMF",
            "VWAP",
            "FIB"
          ],
          "description": "Indicator type to compute for regime logic."
        },
        "params": {
          "type": "object",
          "description": "Indicator-specific parameters (e.g., length)."
        },
        "source": {
          "type": "string",
          "enum": ["open", "high", "low", "close", "hl2", "ohlc4"],
          "description": "Input price series used by the indicator."
        },
        "source_ref": {
          "type": "object",
          "description": "Reference another computed feature as the input series.",
          "properties": { "ref": { "type": "string" } },
          "required": ["ref"]
        }
      },
      "required": ["name", "type"]
    },
    "regime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "Regime name (e.g., trend_up, range, volatile)."
        },
        "conditions": {
          "$ref": "#/$defs/rule_block"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Confidence assigned when conditions are met."
        }
      },
      "required": ["label", "conditions", "confidence"]
    },
    "rule_block": {
      "type": "object",
      "properties": {
        "all_of": { "$ref": "#/$defs/predicate_array" },
        "any_of": { "$ref": "#/$defs/predicate_array" }
      },
      "oneOf": [
        { "required": ["all_of"] },
        { "required": ["any_of"] }
      ]
    },
    "predicate_array": {
      "type": "array",
      "description": "List of conditions used to define a regime.",
      "items": { "$ref": "#/$defs/predicate" },
      "minItems": 1
    },
    "predicate": {
      "type": "object",
      "properties": {
        "condition": {
          "type": "string",
          "enum": ["is_above", "is_below"]
        },
        "left": { "$ref": "#/$defs/operand" },
        "right": { "$ref": "#/$defs/operand" }
      },
      "required": ["condition", "left", "right"]
    },
    "operand": {
      "oneOf": [
        {
          "$ref": "#/$defs/indicator_ref"
        },
        {
          "type": "number",
          "description": "Literal numeric value."
        },
        {
          "type": "string",
          "enum": ["open", "high", "low", "close"],
          "description": "Reference to an OHLC price field."
        }
      ]
    },
    "indicator_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "description": "Name of a feature defined in the features list."
        }
      },
      "required": ["ref"]
    }
  }
}
