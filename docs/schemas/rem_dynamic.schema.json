{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/rem_dynamic.schema.json",
  "title": "Dynamic Risk and Exit Manager (DynamicREM) Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-friendly name for this DynamicREM configuration."
    },
    "version": {
      "type": "string",
      "description": "Optional version tag for this DynamicREM config."
    },
    "stop_loss": { "$ref": "#/$defs/levelRule" },
    "take_profit": { "$ref": "#/$defs/levelRule" },
    "breakeven_threshold": {
      "type": "number",
      "minimum": 0,
      "description": "R-multiple at which to move stop to breakeven."
    },
    "partial_exits": {
      "type": "array",
      "description": "List of partial exit targets.",
      "items": { "$ref": "#/$defs/partialExit" }
    },
    "trailing_stop": { "$ref": "#/$defs/trailingRule" },
    "volatility_threshold": {
      "type": "number",
      "minimum": 0,
      "description": "ADX threshold below which to tighten stops."
    },
    "low_volatility_multiplier": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Multiplier for trailing stop when ADX is low."
    }
  },
  "required": ["stop_loss"],
  "$defs": {
    "levelRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "absolute_price": {
          "type": "number",
          "description": "Exit at this exact price level."
        },
        "price_offset": {
          "type": "number",
          "description": "Exit at entry_price ± price_offset."
        },
        "pips": {
          "type": "number",
          "description": "Exit at entry_price ± pips×pip_size."
        },
        "atr_multiple": {
          "type": "number",
          "description": "Exit at entry_price ± atr_multiple×ATR."
        },
        "atr_length": {
          "type": "integer",
          "minimum": 1,
          "description": "ATR window length (default 14)."
        }
      },
      "oneOf": [
        { "required": ["absolute_price"] },
        { "required": ["price_offset"] },
        { "required": ["pips"] },
        { "required": ["atr_multiple"] }
      ]
    },
    "partialExit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "r_multiple": {
          "type": "number",
          "minimum": 0,
          "description": "R-multiple at which to trigger partial exit."
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of position to close (0.0 to 1.0)."
        }
      },
      "required": ["r_multiple", "fraction"]
    },
    "trailingRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "price_offset": {
          "type": "number",
          "description": "Trail distance in price units."
        },
        "pips": {
          "type": "number",
          "description": "Trail distance in pips."
        },
        "atr_multiple": {
          "type": "number",
          "description": "Trail distance as multiples of ATR."
        },
        "atr_length": {
          "type": "integer",
          "minimum": 1,
          "description": "ATR window length (default 14)."
        },
        "activate_after_partial": {
          "type": "boolean",
          "description": "Only activate trailing after partial exit."
        }
      },
      "oneOf": [
        { "required": ["price_offset"] },
        { "required": ["pips"] },
        { "required": ["atr_multiple"] }
      ]
    }
  }
}
