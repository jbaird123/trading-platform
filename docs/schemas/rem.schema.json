{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/rem.schema.json",
  "title": "Risk and Exit Manager (REM) Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-friendly name for this REM configuration."
    },
    "version": {
      "type": "string",
      "description": "Optional version tag for this REM config."
    },
    "stop_loss": { "$ref": "#/$defs/exitRule" },
    "take_profit": { "$ref": "#/$defs/exitRule" }
  },
  "required": ["stop_loss"],
  "$defs": {
    "exitRule": {
      "oneOf": [
        { "$ref": "#/$defs/fixedPipRule" },
        { "$ref": "#/$defs/indicatorRule" }
      ]
    },
    "fixedPipRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "fixed_pips",
          "description": "Fixed pip-based stop or take-profit."
        },
        "pips": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": 0,
          "description": "Distance in pips from entry price."
        }
      },
      "required": ["type", "pips"]
    },
    "indicatorRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "indicator",
          "description": "Indicator-based stop or take-profit."
        },
        "indicator": {
          "enum": ["atr", "bollinger", "keltner"],
          "description": "Indicator type to use for exit calculation. Only whitelisted indicators are allowed."
        },
        "params": {
          "type": "object",
          "description": "Indicator-specific parameters."
        }
      },
      "required": ["type", "indicator", "params"],
      "allOf": [
        {
          "if": {
            "properties": { "indicator": { "const": "atr" } }
          },
          "then": {
            "properties": {
              "params": { "$ref": "#/$defs/atrParams" }
            }
          }
        },
        {
          "if": {
            "properties": { "indicator": { "const": "bollinger" } }
          },
          "then": {
            "properties": {
              "params": { "$ref": "#/$defs/bollingerParams" }
            }
          }
        },
        {
          "if": {
            "properties": { "indicator": { "const": "keltner" } }
          },
          "then": {
            "properties": {
              "params": { "$ref": "#/$defs/keltnerParams" }
            }
          }
        }
      ]
    },
    "atrParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "length": {
          "type": "integer",
          "minimum": 1,
          "default": 14,
          "description": "ATR lookback period in bars."
        },
        "multiplier": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": 0,
          "description": "Multiplier applied to ATR value."
        }
      },
      "required": ["multiplier"]
    },
    "bollingerParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "length": {
          "type": "integer",
          "minimum": 1,
          "default": 20,
          "description": "Bollinger Bands lookback period."
        },
        "num_std": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": 0,
          "default": 2.0,
          "description": "Number of standard deviations for band width."
        }
      },
      "required": []
    },
    "keltnerParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "length": {
          "type": "integer",
          "minimum": 1,
          "default": 20,
          "description": "Keltner Channel lookback period."
        },
        "atr_length": {
          "type": "integer",
          "minimum": 1,
          "default": 10,
          "description": "ATR period for channel width."
        },
        "multiplier": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": 0,
          "default": 2.0,
          "description": "Multiplier applied to ATR for channel width."
        }
      },
      "required": []
    }
  }
}
