{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/strategy.schema.json",
  "title": "Declarative Strategy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "strategy_name": {
      "type": "string",
      "description": "Human-friendly name shown across the UI."
    },
    "description": {
      "type": "string",
      "description": "Short summary of what the strategy does."
    },
    "version": {
      "type": "string",
      "description": "Optional version tag for this strategy definition."
    },
    "metadata": {
      "type": "object",
      "description": "Miscellaneous info to show or track with the strategy."
    },
    "parameters": {
      "type": "object",
      "description": "Tunable parameters referenced by rules or features.",
      "additionalProperties": {
        "oneOf": [
          { "type": "number" },
          { "type": "integer" },
          { "type": "string" },
          { "type": "boolean" }
        ]
      }
    },
    "features": {
      "type": "array",
      "description": "Indicators/features to compute before evaluating rules.",
      "items": { "$ref": "#/$defs/feature" }
    },
    "overlays": {
      "type": "array",
      "description": "Series names to render on the price chart as overlays.",
      "items": { "type": "string" }
    },
    "risk": {
      "$ref": "#/$defs/risk"
    },
    "entry_rules": {
      "$ref": "#/$defs/rule_block_array"
    },
    "exit_rules": {
      "$ref": "#/$defs/rule_block_array"
    }
  },
  "required": ["strategy_name", "entry_rules", "exit_rules"],
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Local identifier used by rules (e.g., ema_fast)."
        },
        "type": {
          "type": "string",
          "enum": [
            "SMA",
            "EMA",
            "WMA",
            "MACD",
            "PSAR",
            "ADX",
            "RSI",
            "STOCH",
            "CCI",
            "ROC",
            "BB",
            "BBWidth",
            "ATR",
            "HHV",
            "LLV",
            "DC",
            "KC",
            "OBV",
            "CMF",
            "VWAP",
            "FIB"
          ],
          "description": "Indicator type to compute."
        },
        "params": {
          "type": "object",
          "description": "Indicator-specific parameters (e.g., length)."
        },
        "source": {
          "type": "string",
          "enum": ["open", "high", "low", "close", "hl2", "ohlc4"],
          "description": "Input price series used by the indicator."
        },
        "source_ref": {
          "type": "object",
          "description": "Reference another computed feature as the input series.",
          "properties": { "ref": { "type": "string" } },
          "required": ["ref"]
        }
      },
      "required": ["name", "type"]
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["fixed", "atr"],
              "description": "Stop style: fixed amount or ATR-based."
            },
            "value": {
              "type": "number",
              "description": "Stop distance (price units or ATR multiples)."
            }
          },
          "required": ["type", "value"]
        },
        "take_profit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["fixed", "atr"],
              "description": "Take-profit style: fixed or ATR-based."
            },
            "value": {
              "type": "number",
              "description": "TP distance (price units or ATR multiples)."
            }
          },
          "required": ["type", "value"]
        },
        "warmup_bars": {
          "type": "integer",
          "minimum": 0,
          "description": "Bars to ignore while indicators stabilize."
        }
      }
    },
    "rule_block_array": {
      "type": "array",
      "description": "Ordered list of rule blocks; each must evaluate true.",
      "items": { "$ref": "#/$defs/rule_block" },
      "minItems": 1
    },
    "rule_block": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "all_of": {
              "$ref": "#/$defs/predicate_array",
              "description": "All predicates must be true."
            }
          },
          "required": ["all_of"]
        },
        {
          "properties": {
            "any_of": {
              "$ref": "#/$defs/predicate_array",
              "description": "At least one predicate must be true."
            }
          },
          "required": ["any_of"]
        }
      ]
    },
    "predicate_array": {
      "type": "array",
      "description": "List of conditions used inside a rule block.",
      "items": { "$ref": "#/$defs/predicate" },
      "minItems": 1
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "title": "cross_above",
          "properties": {
            "condition": {
              "const": "cross_above",
              "description": "Trigger when left crosses above right."
            },
            "left": {
              "$ref": "#/$defs/operand",
              "description": "Left-hand side (indicator/price/number)."
            },
            "right": {
              "$ref": "#/$defs/operand",
              "description": "Right-hand side (indicator/price/number)."
            }
          },
          "required": ["condition", "left", "right"]
        },
        {
          "title": "cross_below",
          "properties": {
            "condition": {
              "const": "cross_below",
              "description": "Trigger when left crosses below right."
            },
            "left": { "$ref": "#/$defs/operand" },
            "right": { "$ref": "#/$defs/operand" }
          },
          "required": ["condition", "left", "right"]
        },
        {
          "title": "is_above",
          "properties": {
            "condition": {
              "const": "is_above",
              "description": "True if left value is strictly greater than right."
            },
            "left": { "$ref": "#/$defs/operand" },
            "right": { "$ref": "#/$defs/operand" }
          },
          "required": ["condition", "left", "right"]
        },
        {
          "title": "is_below",
          "properties": {
            "condition": {
              "const": "is_below",
              "description": "True if left value is strictly less than right."
            },
            "left": { "$ref": "#/$defs/operand" },
            "right": { "$ref": "#/$defs/operand" }
          },
          "required": ["condition", "left", "right"]
        }
      ]
    },
    "operand": {
      "oneOf": [
        {
          "$ref": "#/$defs/indicator_ref"
        },
        {
          "type": "number",
          "description": "Literal numeric value."
        },
        {
          "type": "string",
          "enum": ["open", "high", "low", "close"],
          "description": "Reference to an OHLC price field."
        }
      ]
    },
    "indicator_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "description": "Name of a feature defined in the features list."
        }
      },
      "required": ["ref"]
    }
  }
}
