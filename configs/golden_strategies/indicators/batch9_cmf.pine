//@version=6
indicator("Golden Validation - Batch 9: CMF", overlay=false)

// BATCH 9: Chaikin Money Flow
// 1 indicator + 5 OHLCV = 6 total columns

// CMF - manual calculation
length_cmf = 20
mfm = ((close - low) - (high - close)) / (high - low)
mfv = mfm * volume
cmf_20 = math.sum(mfv, length_cmf) / math.sum(volume, length_cmf)

// Visual plot
plot(cmf_20, "CMF 20", color=color.blue, linewidth=2)
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_solid)
hline(0.05, "Positive Threshold", color=color.green,
      linestyle=hline.style_dashed)
hline(-0.05, "Negative Threshold", color=color.red,
      linestyle=hline.style_dashed)

// Table showing current value
var table valuesTable = table.new(position.top_right, 2, 2,
                                   bgcolor=color.new(color.black, 80),
                                   border_width=1)

if barstate.islast
    table.cell(valuesTable, 0, 0, "Indicator", text_color=color.white,
               bgcolor=color.new(color.blue, 50))
    table.cell(valuesTable, 1, 0, "Value", text_color=color.white,
               bgcolor=color.new(color.blue, 50))

    table.cell(valuesTable, 0, 1, "CMF 20", text_color=color.white)
    table.cell(valuesTable, 1, 1, str.tostring(cmf_20, "#.####"),
               text_color=color.yellow)
