//@version=6
indicator("Golden Validation - Batch 5: Bollinger Bands", overlay=false)

// BATCH 5: Bollinger Bands
// 3 indicators (upper, middle, lower) + 5 OHLCV = 8 total columns

// Bollinger Bands (3 columns)
[bb_middle, bb_upper, bb_lower] = ta.bb(close, 20, 2.0)

// Visual plots
plot(bb_upper, "BB Upper", color=color.red, linewidth=2)
plot(bb_middle, "BB Middle", color=color.orange, linewidth=2)
plot(bb_lower, "BB Lower", color=color.green, linewidth=2)

// Table showing current values
var table valuesTable = table.new(position.top_right, 2, 4,
                                   bgcolor=color.new(color.black, 80),
                                   border_width=1)

if barstate.islast
    table.cell(valuesTable, 0, 0, "Indicator", text_color=color.white,
               bgcolor=color.new(color.blue, 50))
    table.cell(valuesTable, 1, 0, "Value", text_color=color.white,
               bgcolor=color.new(color.blue, 50))

    table.cell(valuesTable, 0, 1, "BB Upper", text_color=color.white)
    table.cell(valuesTable, 1, 1, str.tostring(bb_upper, "#.#####"),
               text_color=color.yellow)

    table.cell(valuesTable, 0, 2, "BB Middle", text_color=color.white)
    table.cell(valuesTable, 1, 2, str.tostring(bb_middle, "#.#####"),
               text_color=color.yellow)

    table.cell(valuesTable, 0, 3, "BB Lower", text_color=color.white)
    table.cell(valuesTable, 1, 3, str.tostring(bb_lower, "#.#####"),
               text_color=color.yellow)
