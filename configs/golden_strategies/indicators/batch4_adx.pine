//@version=6
indicator("Golden Validation - Batch 4: ADX & DMI", overlay=false)

// BATCH 4: ADX with DMI
// 3 indicators (DI+, DI-, ADX) + 5 OHLCV = 8 total columns

// ADX with DMI (3 columns)
[diPlus, diMinus, adx_14] = ta.dmi(14, 14)

// Visual plots
plot(diPlus, "DI+", color=color.green, linewidth=2)
plot(diMinus, "DI-", color=color.red, linewidth=2)
plot(adx_14, "ADX 14", color=color.blue, linewidth=3)
hline(25, "ADX Threshold", color=color.gray, linestyle=hline.style_dashed)

// Table showing current values
var table valuesTable = table.new(position.top_right, 2, 4,
                                   bgcolor=color.new(color.black, 80),
                                   border_width=1)

if barstate.islast
    table.cell(valuesTable, 0, 0, "Indicator", text_color=color.white,
               bgcolor=color.new(color.blue, 50))
    table.cell(valuesTable, 1, 0, "Value", text_color=color.white,
               bgcolor=color.new(color.blue, 50))

    table.cell(valuesTable, 0, 1, "DI+", text_color=color.white)
    table.cell(valuesTable, 1, 1, str.tostring(diPlus, "#.##"),
               text_color=color.yellow)

    table.cell(valuesTable, 0, 2, "DI-", text_color=color.white)
    table.cell(valuesTable, 1, 2, str.tostring(diMinus, "#.##"),
               text_color=color.yellow)

    table.cell(valuesTable, 0, 3, "ADX 14", text_color=color.white)
    table.cell(valuesTable, 1, 3, str.tostring(adx_14, "#.##"),
               text_color=color.yellow)
