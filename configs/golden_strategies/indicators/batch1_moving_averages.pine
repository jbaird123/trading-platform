//@version=6
indicator("Golden Validation - Batch 1: Moving Averages", overlay=false)

// BATCH 1: Moving Averages
// 6 indicators + 5 OHLCV = 11 total columns

// Moving Averages
sma_20 = ta.sma(close, 20)
ema_20 = ta.ema(close, 20)
wma_20 = ta.wma(close, 20)

// RSI
rsi_14 = ta.rsi(close, 14)

// ATR
atr_14 = ta.atr(14)

// Parabolic SAR
psar = ta.sar(0.02, 0.02, 0.2)

// Visual plots
plot(sma_20, "SMA 20", color=color.blue, linewidth=2)
plot(ema_20, "EMA 20", color=color.orange, linewidth=2)
plot(wma_20, "WMA 20", color=color.green, linewidth=1)
plot(rsi_14, "RSI 14", color=color.purple, linewidth=1)
plot(atr_14, "ATR 14", color=color.red, linewidth=1)
plot(psar, "PSAR", color=color.yellow, linewidth=1, style=plot.style_cross)

// Table showing current values
var table valuesTable = table.new(position.top_right, 2, 7,
                                   bgcolor=color.new(color.black, 80),
                                   border_width=1)

if barstate.islast
    table.cell(valuesTable, 0, 0, "Indicator", text_color=color.white,
               bgcolor=color.new(color.blue, 50))
    table.cell(valuesTable, 1, 0, "Value", text_color=color.white,
               bgcolor=color.new(color.blue, 50))

    table.cell(valuesTable, 0, 1, "SMA 20", text_color=color.white)
    table.cell(valuesTable, 1, 1, str.tostring(sma_20, "#.#####"),
               text_color=color.yellow)

    table.cell(valuesTable, 0, 2, "EMA 20", text_color=color.white)
    table.cell(valuesTable, 1, 2, str.tostring(ema_20, "#.#####"),
               text_color=color.yellow)

    table.cell(valuesTable, 0, 3, "WMA 20", text_color=color.white)
    table.cell(valuesTable, 1, 3, str.tostring(wma_20, "#.#####"),
               text_color=color.yellow)

    table.cell(valuesTable, 0, 4, "RSI 14", text_color=color.white)
    table.cell(valuesTable, 1, 4, str.tostring(rsi_14, "#.##"),
               text_color=color.yellow)

    table.cell(valuesTable, 0, 5, "ATR 14", text_color=color.white)
    table.cell(valuesTable, 1, 5, str.tostring(atr_14, "#.#####"),
               text_color=color.yellow)

    table.cell(valuesTable, 0, 6, "PSAR", text_color=color.white)
    table.cell(valuesTable, 1, 6, str.tostring(psar, "#.#####"),
               text_color=color.yellow)
