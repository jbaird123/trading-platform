//@version=5
strategy("EMA Crossover 20pip Trailing Stop Golden",
         overlay=true,
         initial_capital=100000,
         default_qty_value=10000,
         default_qty_type=strategy.cash,
         commission_type=strategy.commission.percent,
         commission_value=0.0,
         pyramiding=1,
         process_orders_on_close=false,
         calc_on_order_fills=false,
         calc_on_every_tick=false)

// Input parameters (must match our YAML exactly)
ema_fast_length = input.int(20, "Fast EMA Length")
ema_slow_length = input.int(50, "Slow EMA Length")
trailing_stop_pips = input.int(20, "Trailing Stop (pips)")

// Calculate EMAs
ema_fast = ta.ema(close, ema_fast_length)
ema_slow = ta.ema(close, ema_slow_length)

// Plot EMAs for visualization
plot(ema_fast, "EMA Fast", color=color.blue, linewidth=2)
plot(ema_slow, "EMA Slow", color=color.red, linewidth=2)

// Entry conditions
long_entry = ta.crossover(ema_fast, ema_slow)
short_entry = ta.crossunder(ema_fast, ema_slow)

// Exit conditions (signal-based exit)
long_exit = ta.crossunder(ema_fast, ema_slow)
short_exit = ta.crossover(ema_fast, ema_slow)

// Calculate trailing stop in price terms
// For EURUSD: 1 pip = 0.0001, so 20 pips = 0.0020
pip_value = syminfo.mintick * 10  // For EURUSD: 0.00001 * 10 = 0.0001
trailing_stop_distance = trailing_stop_pips * pip_value

// Track whether we just entered on the previous bar
var bool just_entered_long = false
var bool just_entered_short = false

// Execute trades
if long_entry
    strategy.close("Short")
    strategy.entry("Long", strategy.long)
    just_entered_long := true
    just_entered_short := false

if short_entry
    strategy.close("Long")
    strategy.entry("Short", strategy.short)
    just_entered_short := true
    just_entered_long := false

// Apply trailing stop using TradingView's built-in mechanism
// According to TradingView docs:
// - trail_points: profit distance to activate trailing (we want 0 = activate immediately)
// - trail_offset: distance stop trails behind peak price
// IMPORTANT: Both are specified in TICKS (mintick units), not price

// Convert to ticks
trail_offset_ticks = trailing_stop_distance / syminfo.mintick

if just_entered_long and strategy.position_size > 0
    strategy.exit("Long Trail", "Long", loss=trail_offset_ticks, trail_points=0, trail_offset=trail_offset_ticks)
    just_entered_long := false

if just_entered_short and strategy.position_size < 0
    strategy.exit("Short Trail", "Short", loss=trail_offset_ticks, trail_points=0, trail_offset=trail_offset_ticks)
    just_entered_short := false

// Maintain trailing stop for existing positions (must call every bar)
if strategy.position_size > 0 and not just_entered_long
    strategy.exit("Long Trail", "Long", loss=trail_offset_ticks, trail_points=0, trail_offset=trail_offset_ticks)

if strategy.position_size < 0 and not just_entered_short
    strategy.exit("Short Trail", "Short", loss=trail_offset_ticks, trail_points=0, trail_offset=trail_offset_ticks)

// Signal-based exits (override trailing stop if signal triggers first)
if long_exit and strategy.position_size > 0
    strategy.close("Long")

if short_exit and strategy.position_size < 0
    strategy.close("Short")

// Background coloring for regime visualization
bgcolor(ema_fast > ema_slow ? color.new(color.green, 95) : color.new(color.red, 95), title="Trend Direction")
