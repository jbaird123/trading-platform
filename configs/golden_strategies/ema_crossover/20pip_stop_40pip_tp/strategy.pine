//@version=5
strategy("EMA Crossover 20pip Stop 40pip TP Golden",
         overlay=true,
         initial_capital=100000,
         default_qty_value=10000,
         default_qty_type=strategy.cash,
         commission_type=strategy.commission.percent,
         commission_value=0.0,
         pyramiding=1,
         process_orders_on_close=false,
         calc_on_order_fills=false,
         calc_on_every_tick=false)

// Input parameters (must match our YAML exactly)
ema_fast_length = input.int(20, "Fast EMA Length")
ema_slow_length = input.int(50, "Slow EMA Length")
stop_loss_pips = input.int(20, "Stop Loss (pips)")
take_profit_pips = input.int(40, "Take Profit (pips)")

// Calculate EMAs
ema_fast = ta.ema(close, ema_fast_length)
ema_slow = ta.ema(close, ema_slow_length)

// Plot EMAs for visualization
plot(ema_fast, "EMA Fast", color=color.blue, linewidth=2)
plot(ema_slow, "EMA Slow", color=color.red, linewidth=2)

// Entry conditions
long_entry = ta.crossover(ema_fast, ema_slow)
short_entry = ta.crossunder(ema_fast, ema_slow)

// Exit conditions (signal-based exit)
long_exit = ta.crossunder(ema_fast, ema_slow)
short_exit = ta.crossover(ema_fast, ema_slow)

// Calculate stop loss and take profit in price terms
// For EURUSD: 1 pip = 0.0001, so 20 pips = 0.0020, 40 pips = 0.0040
pip_value = syminfo.mintick * 10  // For EURUSD: 0.00001 * 10 = 0.0001
stop_loss_distance = stop_loss_pips * pip_value
take_profit_distance = take_profit_pips * pip_value

// Track whether we just entered on the previous bar
var bool just_entered_long = false
var bool just_entered_short = false
var float long_stop_price = na
var float short_stop_price = na
var float long_tp_price = na
var float short_tp_price = na

// Execute trades
if long_entry
    strategy.close("Short")
    strategy.entry("Long", strategy.long)
    just_entered_long := true
    just_entered_short := false

if short_entry
    strategy.close("Long")
    strategy.entry("Short", strategy.short)
    just_entered_short := true
    just_entered_long := false

// Apply stop-loss and take-profit on the bar AFTER entry using the entry bar's open price
// On signal bar: entry order is placed, just_entered_xxx = true
// On next bar: entry fills at open, we calculate stop/tp based on THIS bar's open
if just_entered_long and strategy.position_size > 0
    long_stop_price := open - stop_loss_distance
    long_tp_price := open + take_profit_distance
    strategy.exit("Long Exit", "Long", stop=long_stop_price, limit=long_tp_price)
    just_entered_long := false
    short_stop_price := na
    short_tp_price := na

if just_entered_short and strategy.position_size < 0
    short_stop_price := open + stop_loss_distance
    short_tp_price := open - take_profit_distance
    strategy.exit("Short Exit", "Short", stop=short_stop_price, limit=short_tp_price)
    just_entered_short := false
    long_stop_price := na
    long_tp_price := na

// Maintain stop/tp for existing positions using the stored prices
if strategy.position_size > 0 and not na(long_stop_price) and not just_entered_long
    strategy.exit("Long Exit", "Long", stop=long_stop_price, limit=long_tp_price)

if strategy.position_size < 0 and not na(short_stop_price) and not just_entered_short
    strategy.exit("Short Exit", "Short", stop=short_stop_price, limit=short_tp_price)

// Signal-based exits (override stop/tp if signal triggers first)
if long_exit and strategy.position_size > 0
    strategy.close("Long")
    long_stop_price := na
    long_tp_price := na

if short_exit and strategy.position_size < 0
    strategy.close("Short")
    short_stop_price := na
    short_tp_price := na

// Clear stop/tp prices when no position
if strategy.position_size == 0
    long_stop_price := na
    short_stop_price := na
    long_tp_price := na
    short_tp_price := na

// Background coloring for regime visualization
bgcolor(ema_fast > ema_slow ? color.new(color.green, 95) : color.new(color.red, 95), title="Trend Direction")
